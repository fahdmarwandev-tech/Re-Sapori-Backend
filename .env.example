# =============================================================================
# RE-SAPORI BACKEND PRODUCTION ENVIRONMENT VARIABLES
# =============================================================================

# 1. Local PostgreSQL Container Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YourSecureDatabasePassword123!
POSTGRES_DB=resaporidb

# 2. Spring Boot Datasource (points to the 'db' service in docker-compose)
DB_LOCAL_URL=jdbc:postgresql://db:5432/resaporidb
DB_LOCAL_USERNAME=postgres
DB_LOCAL_PASSWORD=YourSecureDatabasePassword123!

# 3. Security & JWT (Must be at least 32 characters / 256 bits)
JWT_SECRET=super_secret_jwt_key_that_is_at_least_32_characters_long_for_resapori_prod_2026!

# 4. Cloudinary Image Upload (Optional - safe defaults provided)
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=demo
CLOUDINARY_API_SECRET=demo

# 5. SMTP Mail (Optional - for sending real password reset OTP emails)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEBUG=false
